#!/bin/bash
# Every environment variable this framework reads, with NO values.
#
# The real file on the machine this was built for is env_compy.sh, and it lives
# one directory ABOVE the repository on purpose: it holds live credentials in
# plain text, so git must never see it. This example exists so that a newcomer
# can discover the full set of names without ever being shown a secret.
#
#   cp env.sh.example ../env_local.sh     # OUTSIDE the repo
#   $EDITOR ../env_local.sh               # fill in your own values
#   source ../env_local.sh                # every shell, and atop every job script
#
# Nothing here is portable. The framework has only ever run on PNNL's Compy,
# and the notes below say what each variable is for rather than what to set it
# to, because the right value depends on your machine.

# ---------------------------------------------------------------- modules ---
# Compy needs a compiler and an MPI before the conda environment is usable.
# module load gcc/10.2.0 openmpi/4.0.1

# ------------------------------------------------------------ environment ---
# The conda env is `ideas`, Python 3.12. On CentOS 7 export PIP_ONLY_BINARY
# before installing anything: pip cannot build from source against glibc 2.17.
# conda activate ideas
export PIP_ONLY_BINARY=":all:"

# ------------------------------------------------------------------- LLM ----
# REQUIRED for the agentic pipeline. src/agents/llm_agent.py raises without it.
# The gateway is OpenAI-compatible.
export PNNL_API_KEY=""

# Only if you drive Claude Code itself through the same gateway. Set BOTH or
# NEITHER: the token alone sends a gateway key to api.anthropic.com and 401s
# every subscription session, and the base URL alone points a subscription
# login at a gateway that will not accept it.
# export ANTHROPIC_AUTH_TOKEN="$PNNL_API_KEY"
# export ANTHROPIC_BASE_URL=""

# ------------------------------------------------------------------ ELM -----
# An E3SM source checkout, and a scratch filesystem for the CIME cases.
export E3SM_SRC_DIR=""
export PSCRATCH=""

# Where the ELM server finds this repository, when it is checked out elsewhere.
# export IDEAS_FRAMEWORK_DIR=""

# SLURM. The partition `short` caps at 2 hours; use a longer one beyond that.
export IDEAS_SLURM_ACCOUNT=""
export IDEAS_SLURM_QUEUE=""

# Bulk ELM data. Prefer mcp/elm-mcp/paths.json over these: a standard MCP
# client forwards only HOME, LOGNAME, PATH, SHELL and USER to a server, so an
# exported variable may never reach it.
# export IDEAS_CONUS_RESTART=""
# export IDEAS_CONUS_SURFDATA=""
# export IDEAS_ELM_INPUT_FILES=""

# -------------------------------------------------------------- PFLOTRAN ----
# Only for the coupled and walk paths. PFLOTRAN v7.0 needs PETSc >= 3.21.4.
# The MCP server is a SEPARATE repository, pip-installed as a console script.
export PETSC_DIR=""
export PETSC_ARCH=""
export PFLOTRAN_EXECUTABLE=""
# Absolute, never a bare `mpirun`: a bare name exported by the shell silently
# overrode the absolute path in a server's own .env and worked only while the
# openmpi module happened to be loaded.
export MPI_COMMAND=""

# ----------------------------------------------------------- data sources ---
# Optional. Raises the USGS rate limit; the servers work without it.
# export USGS_API_KEY=""

# AmeriFlux: discovery is open, downloading series is not.
# export AMERIFLUX_USER_ID=""
# export AMERIFLUX_EMAIL=""

# HydroFrame/ParFlow. NOTE: nothing in the code reads these. Access comes from
# a per-machine registration stored by the client library itself:
#   python -c "import hf_hydrodata as hf; hf.register_api_pin('<email>','<pin>')"
# Sign up at https://hydrogen.princeton.edu/signup and get the PIN at .../pin.
# export HYDRODATA_EMAIL=""
# export HYDRODATA_PIN=""

# ------------------------------------------------------------- behaviour ----
# Where MCP server stderr goes. Set to `stderr` to put it back on the terminal
# when debugging a server that will not start.
# export IDEAS_MCP_LOG="logs/mcp_servers.log"
# Downgrades the KeySet unclassified-key error to a warning. Not a fix: the
# keys ARE dropped when you do this.
# export IDEAS_KEYSET_STRICT=1
# Supplies the run-finished notification address in a scripted run.
# export IDEAS_NOTIFY_EMAIL=""
