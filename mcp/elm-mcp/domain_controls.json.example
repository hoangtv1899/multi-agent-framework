{
  "_comment": [
    "Copy to domain_controls.json (not tracked) to name the whole-domain controls",
    "this machine has. A control is a finished whole-domain run that experiments are",
    "built on: its case (the recipe is read from it), its run directory (its output),",
    "how it was shown to reproduce, and the regions and observations prepared for its",
    "grid. Every path must exist, or the control is listed as unusable and says why.",
    "",
    "regions: a polygon (GeoJSON, a cell belongs when its centre is inside) or a field",
    "on the model grid (a cell belongs when var op value). observations: gridded files",
    "on the model grid; one whose var is burned_fraction_year (fraction per cell and",
    "year, with a year axis) gives the control's observed burned area. An observation's",
    "label (optional) is a short name for it, such as \"Satellite record\", that the",
    "details page's burned-area table gives its row; without it the row takes the",
    "observation's what. A label that is not a name written out is left out and named.",
    "",
    "Facts are read from the run by refresh_domain_control_facts and cached beside",
    "this file, in domain_control_facts/<name>.json.",
    "",
    "evaluation (optional): how well the control matches observations, as measured by",
    "an analysis outside the server, with that analysis named as its source. Reception",
    "tells the user about it before a design is settled.",
    "",
    "suite_dir (optional): where the control's suite is built (domain_suite: maps and",
    "region series made once from its history, with suite.json); describe_domain_controls",
    "says whether it is built.",
    "",
    "elevation_band_edges (optional): the study's elevation band edges in m. A control",
    "without them gets an edge at every 500 m inside its own vegetated cells' elevation",
    "range, computed the same way every time and recorded in its suite's manifest.",
    "",
    "measured (optional): measurements to set beside the control, month by month",
    "(domain_measured). Each names a field of the suite, a region of the suite or the",
    "points whose cells the model is read at, a table (csv: month,value, the month as",
    "YYYY-MM) in the units the suite gives the field by month, and the words a page",
    "prints: the panel's title, the line's label, the sentence's subject and what",
    "follows the measured number. Two entries with one field and one region are one",
    "panel. `python src/domain_measured.py <control>` builds measured_month.json in the",
    "suite; the design pages draw it and say its numbers for the years asked about.",
    "",
    "page_figures (optional): the maps the design pages show of the control, each the",
    "sum of its fields' year maps averaged over the years, and the region whose edge is",
    "drawn on them.",
    "",
    "page_summary (optional): {version, written, text, compared}. `text` says what the",
    "control is and is printed on every design page. `compared` says how it compares",
    "with measurements in words, and is printed only where no figure can be drawn.",
    "",
    "page_setup (optional): the control's set-up as rows of a table on the details page,",
    "each {label, words} with both written out, written once by a person who knows the",
    "run and printed as they stand. A row of another form, or one that repeats a label,",
    "is left out and named; the others are kept. No language model reads them.",
    "",
    "known_errors_words (optional): what the control is known to get wrong against",
    "measurements, each a short statement in words. The Planner reads them to judge",
    "which errors matter for a question. A statement that holds a digit is left out,",
    "so no measured number reaches the Planner or the analysis."
  ],
  "controls": {
    "my_basin": {
      "description": "one whole-domain ELM-BGC case over my basin, years Y0-Y1",
      "case_dir": "/path/to/cases/my_basin_control",
      "run_dir": "/path/to/scratch/my_basin_control/run",
      "suite_dir": "/path/to/suites/my_basin",
      "elevation_band_edges": [1000, 1500, 2000],
      "reproduced": {
        "record_dir": "/path/to/<run>/domain_case (a rebuild's chain record)",
        "years": [2015, 2016],
        "fingerprint": "<the rebuild's source fingerprint>",
        "how": "rebuilt from its own records; every numeric history variable identical"
      },
      "evaluation": {
        "summary": "against the gauge and snow pillows, Y0-Y1: what it reproduces and what it misses, with numbers",
        "source": "the analysis that measured it, and its date"
      },
      "regions": {
        "watershed": {"polygon": "/path/to/basin.geojson",
                      "what": "the drainage basin above the gauge"},
        "burned_any_year": {"field": "/path/to/burned_area_on_the_model_grid.nc",
                            "var": "burned_fraction_year", "op": ">", "value": 0.0,
                            "over": "any",
                            "what": "cells where MODIS saw fire in any year 2015-2021: where real fires burned, not where the model's fire burns"}
      },
      "observations": {
        "burned_area": {"path": "/path/to/burned_area_on_the_model_grid.nc",
                        "var": "burned_fraction_year",
                        "what": "observed burned fraction per cell and year",
                        "label": "Satellite record"}
      },
      "measured": [
        {"id": "snow", "field": "H2OSNO",
         "points": [{"id": "station_a", "lat": 46.5, "lon": -121.2}],
         "table": "/path/to/snow_month.csv", "units": "mm",
         "title": "Snow water at one snow pillow", "label": "measured",
         "model_words": "Snow water at the cell of the snow pillow",
         "measured_words": "measured at the pillow",
         "source": "the network, the station and the day the values were fetched"},
        {"id": "river_flow", "field": "QRUNOFF", "region": "watershed",
         "table": "/path/to/river_flow_month.csv", "units": "mm/month",
         "title": "Runoff from the watershed and river flow at its outlet",
         "label": "measured river flow",
         "model_words": "Runoff generated in the watershed",
         "measured_words": "of measured river flow at the outlet",
         "source": "the gauge, over the area it drains"}
      ],
      "page_figures": {
        "maps": [{"words": "Precipitation", "fields": ["RAIN", "SNOW"]},
                 {"words": "Plant growth (GPP)", "fields": ["GPP"]}],
        "outline": "watershed"
      },
      "page_summary": {
        "version": 1, "written": "YYYY-MM-DD",
        "text": ["What the control is: its place, years, grid, weather and settings."],
        "compared": ["How it compares with measurements, for a page with no figure."]
      },
      "page_setup": [
        {"label": "Area", "words": "5,000 km2 of land, about twice the watershed"},
        {"label": "Grid", "words": "100 by 80 cells of about 1 km"},
        {"label": "Years", "words": "Y0 to Y1"},
        {"label": "Fire", "words": "the model's own fire"}
      ],
      "known_errors_words": [
        "It holds less snow than is measured, and its snow melts earlier",
        "It makes more runoff than the river carries"
      ]
    }
  }
}
