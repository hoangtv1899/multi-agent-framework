{
  "_comment": [
    "Copy to domain_controls.json (not tracked) to name the whole-domain controls",
    "this machine has. A control is a finished whole-domain run that experiments are",
    "built on: its case (the recipe is read from it), its run directory (its output),",
    "how it was shown to reproduce, and the regions and observations prepared for its",
    "grid. Every path must exist, or the control is listed as unusable and says why.",
    "",
    "regions: a polygon (GeoJSON, a cell belongs when its centre is inside) or a field",
    "on the model grid (a cell belongs when var op value). observations: gridded files",
    "on the model grid; one whose var is burned_fraction_year (fraction per cell and",
    "year, with a year axis) gives the control's observed burned area.",
    "",
    "Facts are read from the run by refresh_domain_control_facts and cached beside",
    "this file, in domain_control_facts/<name>.json.",
    "",
    "evaluation (optional): how well the control matches observations, as measured by",
    "an analysis outside the server, with that analysis named as its source. Reception",
    "tells the user about it before a design is settled.",
    "",
    "suite_dir (optional): where the control's suite is built (domain_suite: maps and",
    "region series made once from its history, with suite.json); describe_domain_controls",
    "says whether it is built.",
    "",
    "elevation_band_edges (optional): the study's elevation band edges in m. A control",
    "without them gets an edge at every 500 m inside its own vegetated cells' elevation",
    "range, computed the same way every time and recorded in its suite's manifest."
  ],
  "controls": {
    "my_basin": {
      "description": "one whole-domain ELM-BGC case over my basin, years Y0-Y1",
      "case_dir": "/path/to/cases/my_basin_control",
      "run_dir": "/path/to/scratch/my_basin_control/run",
      "suite_dir": "/path/to/suites/my_basin",
      "elevation_band_edges": [1000, 1500, 2000],
      "reproduced": {
        "record_dir": "/path/to/<run>/domain_case (a rebuild's chain record)",
        "years": [2015, 2016],
        "fingerprint": "<the rebuild's source fingerprint>",
        "how": "rebuilt from its own records; every numeric history variable identical"
      },
      "evaluation": {
        "summary": "against the gauge and snow pillows, Y0-Y1: what it reproduces and what it misses, with numbers",
        "source": "the analysis that measured it, and its date"
      },
      "regions": {
        "watershed": {"polygon": "/path/to/basin.geojson",
                      "what": "the drainage basin above the gauge"},
        "burned_any_year": {"field": "/path/to/burned_area_on_the_model_grid.nc",
                            "var": "burned_fraction_year", "op": ">", "value": 0.0,
                            "over": "any",
                            "what": "cells where MODIS saw fire in any year 2015-2021: where real fires burned, not where the model's fire burns"}
      },
      "observations": {
        "burned_area": {"path": "/path/to/burned_area_on_the_model_grid.nc",
                        "var": "burned_fraction_year",
                        "what": "observed burned fraction per cell and year"}
      }
    }
  }
}
