{
  "_comment": "Copy this to mcp_config.json and update paths for your system",
  "mcp_servers": {
    "usgs_water": {
      "command": "/path/to/your/python3",
      "args": [
        "/path/to/RCSFA/mcp/usgs-water-mcp/main.py"
      ],
      "timeout": 300.0
    },
    "geology": {
      "command": "/path/to/your/python3",
      "args": [
        "/path/to/RCSFA/mcp/geology-mcp/main.py"
      ],
      "timeout": 30.0
    },
    "terrain": {
      "command": "/path/to/your/python3",
      "args": [
        "/path/to/RCSFA/mcp/terrain-mcp/main.py"
      ],
      "timeout": 150.0
    },
    "snotel": {
      "command": "/path/to/your/python3",
      "args": [
        "/path/to/RCSFA/mcp/snotel-mcp/main.py"
      ],
      "timeout": 90.0
    },
    "ameriflux": {
      "command": "/path/to/your/python3",
      "args": [
        "/path/to/RCSFA/mcp/ameriflux-mcp/main.py"
      ],
      "timeout": 120.0,
      "description": "AmeriFlux eddy-covariance towers: ET validation sites (discovery only; series needs credentials)"
    },
    "hydrodata": {
      "command": "/path/to/your/python3",
      "args": [
        "/path/to/RCSFA/mcp/hydrodata-mcp/main.py"
      ],
      "timeout": 300.0,
      "description": "ParFlow-CLM CONUS water-table depth (1 km) via HydroFrame. Needs `pip install hf_hydrodata` and a free Princeton email+PIN registered once per machine; see the server's data_status() tool."
    }
  }
}